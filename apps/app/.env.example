# Copiá este archivo como apps/app/.env (no se versiona).
# Todas las variables EXPO_PUBLIC_* terminan en el bundle del cliente: NUNCA pongas secretos acá.

# local | preview | demo | prod
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_API_URL=http://localhost:8787

# Supabase: URL y clave publicable (sb_publishable_…, pública por diseño)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Web pública (opcional). En el teléfono, el correo de confirmación vuelve acá: un enlace a la app
# (crecerencasa:// o exp://) no abre desde el mail. Ejemplo: https://crecer-demo.vercel.app
EXPO_PUBLIC_WEB_URL=
