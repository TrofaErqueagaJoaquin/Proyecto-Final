# Copiá este archivo como apps/app/.env (no se versiona).
# Todas las variables EXPO_PUBLIC_* terminan en el bundle del cliente: NUNCA pongas secretos acá.

# local | preview | demo | prod
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_API_URL=http://localhost:8787

# Se completan en la Fase 2 (proyecto crecer-dev de Supabase): URL y clave publicable (sb_publishable_…, pública por diseño)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
