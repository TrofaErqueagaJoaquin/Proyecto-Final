{
  "name": "@crecer/app",
  "version": "0.1.0",
  "private": true,
  "description": "App universal (Android, iOS y web) con Expo Router.",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "web": "expo start --web",
