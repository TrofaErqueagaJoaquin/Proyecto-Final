{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm exec expo export --platform web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/actividades/:slug", "destination": "/actividades/[slug].html" },
    { "source": "/etapas/:slug", "destination": "/etapas/[slug].html" },
    { "source": "/situaciones/:slug", "destination": "/situaciones/[slug].html" },
    { "source": "/directorio/:id", "destination": "/directorio/[id].html" },
    { "source": "/asistente/:conversationId", "destination": "/asistente/[conversationId].html" },
    {
      "source": "/evaluaciones/historial/:memberId",
      "destination": "/evaluaciones/historial/[memberId].html"
    },
    {
      "source": "/evaluaciones/:attemptId/responder",
      "destination": "/evaluaciones/[attemptId]/responder.html"
    },
    {
      "source": "/evaluaciones/:attemptId/resultado",
      "destination": "/evaluaciones/[attemptId]/resultado.html"
    },
    { "source": "/familia/integrante/:id", "destination": "/familia/integrante/[id].html" },
    {
      "source": "/profesionales/:assignmentId",
      "destination": "/profesionales/[assignmentId].html"
    },
    {
      "source": "/profesional/casos/:assignmentId/:memberId",
      "destination": "/profesional/casos/[assignmentId]/[memberId].html"
    }
  ],
  "headers": [
    {
      "source": "/_expo/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
