{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm exec expo export --platform web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/actividades/:slug",
      "destination": "/actividades/%5Bslug%5D"
    },
    {
      "source": "/etapas/:slug",
      "destination": "/etapas/%5Bslug%5D"
    },
    {
      "source": "/situaciones/:slug",
      "destination": "/situaciones/%5Bslug%5D"
    },
    {
      "source": "/directorio/:id",
      "destination": "/directorio/%5Bid%5D"
    },
    {
      "source": "/asistente/:conversationId",
      "destination": "/asistente/%5BconversationId%5D"
    },
    {
      "source": "/evaluaciones/historial/:memberId",
      "destination": "/evaluaciones/historial/%5BmemberId%5D"
    },
    {
      "source": "/evaluaciones/:attemptId/responder",
      "destination": "/evaluaciones/%5BattemptId%5D/responder"
    },
    {
      "source": "/evaluaciones/:attemptId/resultado",
      "destination": "/evaluaciones/%5BattemptId%5D/resultado"
    },
    {
      "source": "/familia/integrante/:id",
      "destination": "/familia/integrante/%5Bid%5D"
    },
    {
      "source": "/profesionales/:assignmentId",
      "destination": "/profesionales/%5BassignmentId%5D"
    },
    {
      "source": "/profesional/casos/:assignmentId/:memberId",
      "destination": "/profesional/casos/%5BassignmentId%5D/%5BmemberId%5D"
    }
  ],
  "headers": [
    {
      "source": "/_expo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
