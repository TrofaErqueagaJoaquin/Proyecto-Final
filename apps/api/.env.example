# Copiá este archivo como apps/api/.env (no se versiona).
# Estas variables viven solo en el servidor (Vercel Environment Variables en producción).

# local | preview | demo | prod
APP_ENV=local
PORT=8787
# Orígenes permitidos para CORS, separados por coma (Expo web corre en el 8081)
CORS_ORIGINS=http://localhost:8081

# Supabase (Project Settings → API Keys)
SUPABASE_URL=https://<project-ref>.supabase.co
# Clave publicable (sb_publishable_…): pública por diseño; la API la usa junto con el JWT del usuario.
SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (sb_secret_…): SALTEA RLS. Nunca en la app ni en el chat. Opcional en desarrollo.
SUPABASE_SECRET_KEY=

# Origen público de la app (enlaces de invitación)
APP_PUBLIC_URL=http://localhost:8081

# Correo transaccional (opcional; sin clave, las invitaciones se comparten por enlace)
RESEND_API_KEY=
MAIL_FROM=Crecer en Casa <no-responder@tu-dominio>

# Fase 8
# ANTHROPIC_API_KEY=
# VOYAGE_API_KEY=
