# Copiá este archivo como apps/api/.env (no se versiona).
# Estas variables son secretas: viven solo en el servidor (Vercel Environment Variables en producción).

# local | preview | demo | prod
APP_ENV=local
PORT=8787
# Orígenes permitidos para CORS, separados por coma (Expo web corre en el 8081)
CORS_ORIGINS=http://localhost:8081

