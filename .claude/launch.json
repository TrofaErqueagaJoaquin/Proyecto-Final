{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@crecer/api", "dev"],
      "port": 8787
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@crecer/app", "exec", "expo", "start", "--port", "8081"],
      "port": 8081,
      "env": {
        "NODE_OPTIONS": "--max-old-space-size=4096"
      }
    }
  ]
}
