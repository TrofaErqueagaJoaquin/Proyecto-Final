{
  "name": "crecer-en-casa",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de orientación familiar sobre desarrollo infantil y uso de pantallas.",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@crecer/api",
    "dev:app": "turbo run dev --filter=@crecer/app",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:test:local": "node scripts/db-test-local.mjs",
    "db:test": "supabase test db",
    "db:push": "supabase db push --linked",
    "db:types": "supabase gen types typescript --linked --schema public > packages/shared/src/db.types.ts",
    "content:check": "tsx scripts/content-sync.mts --check",
    "content:sync": "tsx --env-file=apps/api/.env scripts/content-sync.mts",
    "pro:verify": "tsx --env-file=apps/api/.env scripts/pro-verify.mts",
    "kb:ingest": "tsx --env-file=apps/api/.env scripts/kb-ingest.mts",
    "admin:grant": "tsx --env-file=apps/api/.env scripts/admin-grant.mts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@crecer/domain": "workspace:*",
    "@crecer/shared": "workspace:*",
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-pgvector": "0.0.11",
    "@supabase/supabase-js": "^2.118.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "supabase": "2.122.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
